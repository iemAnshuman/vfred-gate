{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "contract_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contract Sha256"
    },
    "legality_status": {
      "const": "not_assessed",
      "default": "not_assessed",
      "title": "Legality Status",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "rules": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Rules",
      "type": "array"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    }
  },
  "required": [
    "verdict",
    "exit_code"
  ],
  "title": "Verdict",
  "type": "object"
}
